     ]
    },
    {
     "_type": "span",
     "_key": "f0863ca92c56",
     "text": " Luft-Wasser 15.000 € · Geothermie (Gerät + Bohrung) 30.000 €",
     "marks": []
    }
   ],
   "markDefs": [],
   "listItem": "bullet",
   "level": 1
  },
