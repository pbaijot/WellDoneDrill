   "children": [
    {
     "_type": "span",
     "_key": "6010685c3b2b",
     "text": "Auch wenn die Einstiegskosten höher sind, ermöglicht die Geothermie über 25 Jahre eine Nettoersparnis von mehr als ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "a9ec1db3be06",
