   "children": [
    {
     "_type": "span",
     "_key": "acf6603720dc",
     "text": "1. De initiële investering: de boring is een bezit, geen uitgave",
     "marks": []
    }
   ],
   "markDefs": []
  },
  {
   "_type": "block",
   "_key": "daab72350bbd",
   "style": "normal",
   "children": [
    {
     "_type": "span",
     "_key": "20780a2f25e7",
     "text": "Het klopt dat een geothermische warmtepomp bij aanvang meer kost, vooral door de boring tot 150 meter.",
     "marks": []
    }
   ],
   "markDefs": []
  },
  {
